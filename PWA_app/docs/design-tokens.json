{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Shakar Design Tokens V2",
  "version": "2.0",
  "color": {
    "brand": {
      "100": "#E5E5E5",
      "400": "#D4D4D4",
      "500": "#FAFAFA",
      "600": "#A1A1A1",
      "900": "#0A0A0A"
    },
    "signal": {
      "400": "#6FCF97",
      "500": "#46B978",
      "600": "#1F8A4C",
      "100-dark": "rgba(70, 185, 120, 0.08)",
      "100-light": "rgba(31, 138, 76, 0.08)"
    },
    "warning": {
      "500-dark": "#D9A13B",
      "500-light": "#B97900"
    },
    "danger": {
      "500-dark": "#DE6B6B",
      "500-light": "#C24040"
    },
    "semantic-dark": {
      "surface-page": "#0A0A0A",
      "surface-base": "#111111",
      "surface-raised": "#171717",
      "surface-overlay": "#1F1F1F",
      "text-primary": "#FAFAFA",
      "text-secondary": "#A1A1A1",
      "text-muted": "#737373",
      "text-disabled": "#525252",
      "border-subtle": "#262626",
      "border-default": "#2E2E2E",
      "border-strong": "#404040",
      "action-primary": "#FAFAFA",
      "signal": "#46B978",
      "warning": "#D9A13B",
      "danger": "#DE6B6B",
      "focus-ring": "#E5E5E5",
      "surface-brand": "#1C1C1C",
      "surface-signal": "rgba(70, 185, 120, 0.08)",
      "text-on-brand": "#0A0A0A",
      "text-on-signal": "#0A0A0A",
      "action-primary-hover": "#FFFFFF",
      "action-primary-active": "#E5E5E5"
    },
    "semantic-light": {
      "surface-page": "#F4F4F5",
      "surface-base": "#FFFFFF",
      "surface-raised": "#FFFFFF",
      "surface-overlay": "#FFFFFF",
      "text-primary": "#0A0A0A",
      "text-secondary": "#52525B",
      "text-muted": "#71717A",
      "text-disabled": "#A1A1AA",
      "border-subtle": "#E7E7E9",
      "border-default": "#D4D4D8",
      "border-strong": "#A1A1AA",
      "action-primary": "#0A0A0A",
      "signal": "#1F8A4C",
      "warning": "#B97900",
      "danger": "#C24040",
      "focus-ring": "#0A0A0A",
      "surface-brand": "#ECECEE",
      "surface-signal": "rgba(31, 138, 76, 0.08)",
      "text-on-brand": "#FAFAFA",
      "text-on-signal": "#FFFFFF",
      "action-primary-hover": "#26262A",
      "action-primary-active": "#000000"
    }
  },
  "typography": {
    "font-family": [
      "Vazirmatn",
      "Inter",
      "ui-sans-serif",
      "system-ui",
      "sans-serif"
    ],
    "display-lg": {
      "size": "40px",
      "lineHeight": 1.12,
      "weight": 600
    },
    "display-md": {
      "size": "32px",
      "lineHeight": 1.15,
      "weight": 600
    },
    "heading-xl": {
      "size": "24px",
      "lineHeight": 1.25,
      "weight": 600
    },
    "heading-lg": {
      "size": "20px",
      "lineHeight": 1.35,
      "weight": 600
    },
    "heading-md": {
      "size": "18px",
      "lineHeight": 1.4,
      "weight": 600
    },
    "body-lg": {
      "size": "16px",
      "lineHeight": 1.55,
      "weight": 400
    },
    "body-md": {
      "size": "15px",
      "lineHeight": 1.55,
      "weight": 400
    },
    "body-sm": {
      "size": "14px",
      "lineHeight": 1.5,
      "weight": 400
    },
    "label-md": {
      "size": "13px",
      "lineHeight": 1.4,
      "weight": 500
    },
    "label-sm": {
      "size": "12px",
      "lineHeight": 1.35,
      "weight": 500
    },
    "caption": {
      "size": "11px",
      "lineHeight": 1.35,
      "weight": 400
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "80px",
    "10": "120px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "pill": "9999px"
  },
  "motion": {
    "micro": {
      "duration": "150ms",
      "easing": "cubic-bezier(0.23,1,0.32,1)"
    },
    "standard": {
      "duration": "200ms",
      "easing": "cubic-bezier(0.23,1,0.32,1)"
    },
    "complex": {
      "duration": "250ms",
      "easing": "cubic-bezier(0.23,1,0.32,1)"
    }
  },
  "layout": {
    "mobile": {
      "gutter": "16px",
      "sectionGap": "32px",
      "majorSectionGap": "48px",
      "cardPadding": "16px",
      "resultGap": "12px",
      "controlGroupGap": "12px"
    },
    "desktop": {
      "gutter": "24px",
      "gutterWide": "32px",
      "sectionGap": "48px",
      "majorSectionGap": "80px",
      "cardPadding": "20px",
      "resultGap": "16px"
    },
    "contentMax": "1200px"
  }
}